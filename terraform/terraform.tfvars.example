aws_region          = "us-east-1"
environment         = "dev"
worker_image        = "123456789012.dkr.ecr.us-east-1.amazonaws.com/appt-mgmt-worker:latest"
acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/replace-with-real-certificate-id"

# Replace this documentation-only range with the API gateway's trusted caller CIDR.
allowed_ingress_cidrs = ["203.0.113.0/24"]

worker_port  = 3003
task_cpu     = 256
task_memory  = 512
desired_count = 1
